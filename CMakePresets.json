{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 29,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}"
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "description": "llvm-mingw: Clang, libc++ and LLD for Windows, from a Windows or Linux host. Its bin folder is in PATH.",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "AMD64",
        "CMAKE_C_COMPILER": "x86_64-w64-mingw32-clang",
        "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-clang++"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "base",
      "description": "Clang with libc++ and LLD.",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "relwithdebinfo",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "webgpu",
      "hidden": true,
      "cacheVariables": {
        "NOORRHI_BACKEND": "WebGpu"
      }
    },
    {
      "name": "web",
      "hidden": true,
      "inherits": "base",
      "description": "Emscripten from an activated emsdk; always WebGPU.",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "inherits": [
        "windows",
        "debug"
      ]
    },
    {
      "name": "windows-relwithdebinfo",
      "displayName": "Windows RelWithDebInfo",
      "inherits": [
        "windows",
        "relwithdebinfo"
      ]
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "inherits": [
        "windows",
        "release"
      ]
    },
    {
      "name": "windows-webgpu-debug",
      "displayName": "Windows WebGPU Debug",
      "inherits": [
        "windows",
        "webgpu",
        "debug"
      ]
    },
    {
      "name": "windows-webgpu-relwithdebinfo",
      "displayName": "Windows WebGPU RelWithDebInfo",
      "inherits": [
        "windows",
        "webgpu",
        "relwithdebinfo"
      ]
    },
    {
      "name": "windows-webgpu-release",
      "displayName": "Windows WebGPU Release",
      "inherits": [
        "windows",
        "webgpu",
        "release"
      ]
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "inherits": [
        "linux",
        "debug"
      ]
    },
    {
      "name": "linux-relwithdebinfo",
      "displayName": "Linux RelWithDebInfo",
      "inherits": [
        "linux",
        "relwithdebinfo"
      ]
    },
    {
