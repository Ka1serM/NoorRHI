        "relwithdebinfo"
      ]
    },
    {
      "name": "linux-webgpu-release",
      "displayName": "Linux WebGPU Release",
      "inherits": [
        "linux",
        "webgpu",
        "release"
      ]
    },
    {
      "name": "web-debug",
      "displayName": "Web Debug",
      "inherits": [
        "web",
        "debug"
      ]
    },
    {
      "name": "web-release",
      "displayName": "Web Release",
      "inherits": [
        "web",
        "release"
      ]
    }
  ],
