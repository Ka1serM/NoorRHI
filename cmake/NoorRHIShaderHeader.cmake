#! Runs with cmake -P and writes HEADER with one NoorRHI::Shader per entry point. The entry points come from the Slang reflection in REFLECTION, or for a ray tracing source from the list in ENTRIES.
set(stages compute vertex fragment raygeneration miss closesthit anyhit intersection callable)
set(names Compute Vertex Fragment RayGeneration Miss ClosestHit AnyHit Intersection Callable)
set(entries "")
string(REPLACE "," ";" codes "${CODES}")
#! Each Shader reads the assembler symbols itself: on COFF the linker can run the initializers of inline variables in any order.
set(code_value "")
foreach(symbol IN LISTS codes)
    string(APPEND code_value "std::span<const std::byte>{${symbol}, ${symbol}_size}, ")
endforeach()
string(REGEX REPLACE ", $" "" code_value "${code_value}")
set(code_value "{{${code_value}}}")

if(DEFINED ENTRIES)
    include("${ENTRIES}")
    foreach(stage IN ITEMS raygeneration miss closesthit anyhit intersection callable)
        list(FIND stages ${stage} found)
        list(GET names ${found} stageName)
        set(index 0)
        foreach(entry IN LISTS fallback_${stage})
            string(APPEND entries "inline const NoorRHI::Shader ${entry}{${code_value}, \"${entry}\", NoorRHI::ShaderStage::${stageName}, {}, ${index}};\n")
            math(EXPR index "${index} + 1")
        endforeach()
    endforeach()
else()
    file(READ "${REFLECTION}" json)
    string(JSON count LENGTH "${json}" entryPoints)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON entry GET "${json}" entryPoints ${index} name)
            string(JSON stage GET "${json}" entryPoints ${index} stage)
            list(FIND stages "${stage}" found)
            if(found LESS 0)
                message(FATAL_ERROR "${REFLECTION}: the entry point ${entry} has the stage ${stage}, which NoorRHI does not support")
            endif()
            list(GET names ${found} stageName)
            set(size "{}")
            string(JSON groupSize ERROR_VARIABLE missing GET "${json}" entryPoints ${index} threadGroupSize)
            if(NOT missing)
                string(JSON x GET "${groupSize}" 0)
                string(JSON y GET "${groupSize}" 1)
                string(JSON z GET "${groupSize}" 2)
                set(size "{${x}, ${y}, ${z}}")
            endif()
            string(APPEND entries "inline const NoorRHI::Shader ${entry}{${code_value}, \"${entry}\", NoorRHI::ShaderStage::${stageName}, ${size}};\n")
        endforeach()
    endif()
endif()

set(declarations "")
set(declared "")
foreach(symbol IN LISTS codes)
    if(symbol IN_LIST declared)
        continue()
    endif()
    list(APPEND declared "${symbol}")
    string(APPEND declarations "extern \"C\" const std::byte ${symbol}[];\nextern \"C\" const std::uint32_t ${symbol}_size;\n")
endforeach()

set(content "//! Generated by noorrhi_add_shaders from ${NAME}.slang.
#pragma once

#include <cstddef>
#include <cstdint>
#include <span>

#include \"NoorRHI/Pipelines/Pipeline.h\"

${declarations}
namespace ${NAME} {

${entries}
}
")
file(WRITE "${HEADER}" "${content}")
