#! Generated by tools/generate_webgpu_bindings.py; runs with cmake -P on FILE, a WGSL module from slangc, and gives the storage pools that NoorRHIWebGpu.slang declares as rgba32float their real formats.
file(READ "${FILE}" text)
foreach(pool IN ITEMS "53:rgba16float" "57:r16float" "58:r8unorm")
    string(REPLACE ":" ";" pool "${pool}")
    list(GET pool 0 binding)
    list(GET pool 1 format)
    string(REGEX REPLACE "(noorrhi_pool_${binding}_[0-9]+ : texture_storage_2d_array<)rgba32float" "\\1${format}" text "${text}")
endforeach()
file(WRITE "${FILE}" "${text}")
